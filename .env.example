PORT=3090
DB_PATH=./data/ponto.db

# Segurança do agente Windows -> CMTB-SRV01
# Em produção, definir um token longo e aleatório.
AGENT_TOKEN=trocar-por-token-forte

# Chave de 32 bytes para criptografar o PIN de 4 dígitos dos servidores.
# Gere em produção com: openssl rand -hex 32
# Não reutilize AGENT_TOKEN e não versione a chave real.
PIN_ENCRYPTION_KEY=

# REP 02 - Topdata Inner REP Bio (contingência)
# Se TOPDATA_HOST estiver definido, o dispositivo é criado automaticamente na base.
TOPDATA_HOST=10.20.20.222
TOPDATA_PORT=51000
TOPDATA_AGENT_ID=topdata-windows-01

# Intervalo de coleta do agente, em segundos
COLLECT_INTERVAL_SECONDS=30

# Hikvision / outros equipamentos diretos (opcional)
HIKVISION_BASE_URL=
HIKVISION_USERNAME=
HIKVISION_PASSWORD=

# Exportador IPM
# O portal oferece AFD bruto de marcações Topdata (homologação) e CSV de conferência.
# O layout definitivo do IPM deve ser ajustado se o Atende.Net exigir outro formato.
IPM_EXPORT_MODE=topdata-afd-attendance

# Gateway WhatsApp já existente no CMTB-SRV01.
# A chave real fica somente no arquivo de ambiente de produção.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3061
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_WORKER_INTERVAL_SECONDS=10

# Foto automática na batida do ponto.
# Use usuário dedicado da câmera com permissão apenas de visualização/RTSP.
ATTENDANCE_CAMERA_ENABLED=0
ATTENDANCE_CAMERA_DEVICE_ID=rep-topdata-02
ATTENDANCE_TIMEZONE=America/Sao_Paulo
ATTENDANCE_CAMERA_RTSP_URL=
ATTENDANCE_CAMERA_BUFFER_FPS=2
ATTENDANCE_CAMERA_BUFFER_SECONDS=100
# Como o Topdata é coletado em ciclos, mantém 2500 ms como fallback seguro.
ATTENDANCE_CAMERA_CAPTURE_OFFSET_MS=2500
# O AFD legado Topdata informa HH:mm, sem segundos. Por isso a camera nao usa
# occurredAt como instante exato da foto: ela varre o buffer anterior ao recebimento.
# Não há reconhecimento facial nem envio de imagem para serviço externo.
ATTENDANCE_CAMERA_PRESENCE_SELECTION_ENABLED=1
# Instantes (ms antes do recebimento do NSR) avaliados na regiao do REP.
ATTENDANCE_CAMERA_SCAN_OFFSETS_MS=0,2000,4000,6000,8000,10000
# Quadro anterior usado como referencia de ambiente sem pessoa.
ATTENDANCE_CAMERA_SCAN_REFERENCE_OFFSET_MS=14000
# Como o AFD Topdata informa apenas o minuto, a busca principal percorre toda a
# faixa plausivel daquele minuto dentro de um buffer maior.
ATTENDANCE_CAMERA_MINUTE_SCAN_STEP_MS=2000
ATTENDANCE_CAMERA_MINUTE_MIN_AGE_MS=1000
ATTENDANCE_CAMERA_MINUTE_BACKGROUND_GAP_MS=3000
# ROI normalizada: x,y,largura,altura. O padrão cobre a área esquerda onde fica o REP.
ATTENDANCE_CAMERA_PRESENCE_ROI=0,0.05,0.38,0.85
# Percentual minimo da ROI com mudanca local apos compensar variacao global de luz.
ATTENDANCE_CAMERA_PRESENCE_MIN_DIFFERENCE=0.025
# Evita associar foto atual a marcações históricas/importadas.
ATTENDANCE_CAMERA_EVENT_MAX_AGE_SECONDS=90
ATTENDANCE_PHOTO_DIR=./data/attendance-photos
ATTENDANCE_PHOTO_RETENTION_DAYS=90

# Simulador Control iD 671 para testes de protocolo com IPM
SIM_PORT=3091
SIM_USER=admin
SIM_PASSWORD=123456
SIM_SERIAL=00014000000000001
SIM_LOG_DIR=./data/simulator


# Escrita de empregados no REP Topdata: permanece bloqueada por padrao.
# Para homologacao, habilite e informe somente os PIS/PASEP autorizados.
TOPDATA_ENABLE_EMPLOYEE_WRITE=0
TOPDATA_WRITE_ALLOW_PIS=

# Login do portal
# Gere com: openssl rand -hex 32
AUTH_RESET_PEPPER=
AUTH_SESSION_HOURS=12
# Em HTTPS/Cloudflare, use 1. Em acesso HTTP local, use 0.
AUTH_COOKIE_SECURE=1

# Recuperação de senha por Gmail (senha de app, nunca a senha normal da conta)
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Câmara Municipal de Três Barras
