PORT=3090
DB_PATH=./data/ponto.db

# Hikvision DS-K1T342MX-E1
HIKVISION_BASE_URL=http://192.168.1.100
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=trocar

# Janela de coleta em minutos
COLLECT_INTERVAL_SECONDS=30

# Exportador IPM
# O layout definitivo será implementado após obtermos um arquivo real aceito pelo IPM.
IPM_EXPORT_MODE=generic-csv

# Simulador Control iD 671 para teste com IPM
SIM_PORT=3091
SIM_USER=admin
SIM_PASSWORD=admin
SIM_SERIAL=SIM671000001
SIM_LOG_DIR=./data/simulator
# Para HTTPS, informe caminhos de certificado/chave:
# SIM_TLS_CERT=/caminho/cert.pem
# SIM_TLS_KEY=/caminho/key.pem
